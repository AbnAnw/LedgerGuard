# Copy this file to .env for local development. Never commit .env.
APP_ENV=development
APP_NAME=LedgerGuard
LOG_LEVEL=INFO
# Empty uses the local structured-log span exporter. Set an OTLP collector base URL in hosted
# environments, for example https://collector.internal:4318 (never put credentials in this URL).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_STRUCTURED_LOG_EXPORTER=true
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Local-only placeholders. The owner account is used only by the one-shot migration service;
# the API and worker connect through the separate non-owner runtime account.
POSTGRES_DB=ledgerguard
POSTGRES_USER=ledgerguard
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_RUNTIME_USER=ledgerguard_app
DATABASE_RUNTIME_PASSWORD=replace-with-a-different-local-password
DATABASE_URL=postgresql+psycopg://ledgerguard_app:replace-with-a-different-local-password@postgres:5432/ledgerguard
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
BACKGROUND_JOB_MAX_ATTEMPTS=3
BACKGROUND_JOB_SOFT_TIME_LIMIT_SECONDS=300
BACKGROUND_JOB_HARD_TIME_LIMIT_SECONDS=330

# Generate a local secret in .env before sharing or exposing the environment.
AUTH_SECRET_KEY=replace-with-a-long-random-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Known local-only synthetic demo password. Replace it in .env before seeding.
# The seed command is blocked when APP_ENV=production.
DEMO_USER_PASSWORD=replace-with-a-local-demo-password

# Request/resource guardrails. MAX_REQUEST_BODY_BYTES includes multipart envelope overhead.
INGESTION_MAX_UPLOAD_BYTES=2000000
MAX_REQUEST_BODY_BYTES=3000000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_WINDOW=120
RATE_LIMIT_LOGIN_REQUESTS_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60
SYNTHETIC_DATA_ONLY=true

# Display only. Persistence and API timestamps remain UTC.
DISPLAY_TIMEZONE=UTC
CORS_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
VITE_API_BASE_URL=http://localhost:8000

# Day 18 optional provider. Empty selects the deterministic fallback.
AI_PROVIDER=deterministic
AI_API_KEY=
