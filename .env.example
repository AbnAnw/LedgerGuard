# Copy this file to .env for local development. Never commit .env.
APP_ENV=development
APP_NAME=LedgerGuard
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173

# Local-only placeholder credentials; Day 3 will align these with Docker Compose.
POSTGRES_DB=ledgerguard
POSTGRES_USER=ledgerguard
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ledgerguard:replace-with-local-password@postgres:5432/ledgerguard
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
BACKGROUND_JOB_MAX_ATTEMPTS=3
BACKGROUND_JOB_SOFT_TIME_LIMIT_SECONDS=300
BACKGROUND_JOB_HARD_TIME_LIMIT_SECONDS=330

# Generate a local secret in .env before sharing or exposing the environment.
AUTH_SECRET_KEY=replace-with-a-long-random-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Known local-only synthetic demo password. Replace it in .env before seeding.
# The seed command is blocked when APP_ENV=production.
DEMO_USER_PASSWORD=replace-with-a-local-demo-password

# Request-body safety bound; Day 9 parsing and row validation run in the worker.
INGESTION_MAX_UPLOAD_BYTES=2000000

# Display only. Persistence and API timestamps remain UTC.
DISPLAY_TIMEZONE=UTC
CORS_ORIGINS=["http://localhost:5173"]
VITE_API_BASE_URL=http://localhost:8000

# Day 18 optional provider. Empty selects the deterministic fallback.
AI_PROVIDER=deterministic
AI_API_KEY=
