# Copy this file to .env for local development. Never commit .env.
APP_ENV=development
APP_NAME=LedgerGuard
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173

# Local-only placeholder credentials; Day 3 will align these with Docker Compose.
POSTGRES_DB=ledgerguard
POSTGRES_USER=ledgerguard
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ledgerguard:replace-with-local-password@postgres:5432/ledgerguard
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Day 4 will require a generated value in .env, never in source control.
AUTH_SECRET_KEY=replace-with-a-long-random-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Display only. Persistence and API timestamps remain UTC.
DISPLAY_TIMEZONE=UTC
CORS_ORIGINS=["http://localhost:5173"]
VITE_API_BASE_URL=http://localhost:8000

# Day 18 optional provider. Empty selects the deterministic fallback.
AI_PROVIDER=deterministic
AI_API_KEY=
